{
  "welcomeFile": "/manageinvoices/webapp/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 10,
  "routes": [				
    {
      "source": "^/manageinvoices/webapp/(.*)",
      "localDir": "manageinvoices/webapp/",
      "target": "$1",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
       "source": "^/user-api/currentUser$",
       "target": "/currentUser",
       "service": "sap-approuter-userapi"
    },
    {
      "source": "^/(.*)$",
      "authenticationType": "xsuaa",
      "destination": "srv-api"
    }
  ],
  "logout": {
     "logoutEndpoint": "/my/logout",
     "logoutPage": "/logout-page.html"
  } 
}